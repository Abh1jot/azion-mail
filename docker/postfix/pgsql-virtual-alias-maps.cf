# PostgreSQL Virtual Alias Maps (Aliases + Multi-Recipient Forwarders + Catch-All)
hosts = ${POSTGRES_HOST}
user = ${POSTGRES_USER}
password = ${POSTGRES_PASSWORD}
dbname = ${POSTGRES_DB}
query = SELECT a."destination" FROM "Alias" a JOIN "Domain" d ON a."domainId" = d."id" WHERE a."source" = '%s' AND a."isActive" = true AND d."status" = 'ACTIVE' UNION SELECT unnest(f."destinations") AS destination FROM "Forwarder" f JOIN "Domain" d ON f."domainId" = d."id" WHERE f."sourceAddress" = '%s' AND f."isActive" = true AND d."status" = 'ACTIVE' UNION SELECT '%s' AS destination FROM "Forwarder" f JOIN "Domain" d ON f."domainId" = d."id" WHERE f."sourceAddress" = '%s' AND f."keepLocalCopy" = true AND f."isActive" = true AND d."status" = 'ACTIVE'

