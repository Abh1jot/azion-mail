{
    email {$ACME_EMAIL:admin@azioncloud.com}
    admin off
}

# Using MAIL_HOST (FQDN) triggers Caddy's automatic HTTPS / Let's Encrypt.
# A bare ":80" would disable TLS — always use the domain name here.
{$MAIL_HOST:mail.azioncloud.com} {
    # SnappyMail Webmail routing & assets
    redir /webmail /webmail/ 308

    handle_path /webmail* {
        reverse_proxy webmail:8888 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
        }
    }

    handle /snappymail* {
        reverse_proxy webmail:8888 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
        }
    }

    # Autoconfig & Autodiscover routes for email clients
    handle /mail/config-v1.1.xml* {
        reverse_proxy web:3000
    }
    handle /autodiscover/* {
        reverse_proxy web:3000
    }

    # Main Azion Mail SaaS Dashboard & REST API
    handle {
        reverse_proxy web:3000 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
        }
    }

    # Compression
    encode gzip zstd
}
