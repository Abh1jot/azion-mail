# Dovecot PostgreSQL Authentication & Virtual User Query
driver = pgsql
connect = host=${POSTGRES_HOST} dbname=${POSTGRES_DB} user=${POSTGRES_USER} password=${POSTGRES_PASSWORD}

default_pass_scheme = BLF-CRYPT

password_query = SELECT m."address" as user, \
  replace(m."passwordHash", '$2b$', '$2y$') as password \
  FROM "Mailbox" m JOIN "Domain" d ON m."domainId" = d."id" \
  WHERE m."address" = '%u' AND m."isActive" = true AND m."isSuspended" = false AND d."status" = 'ACTIVE'

user_query = SELECT 5000 as uid, 5000 as gid, \
  concat('/var/mail/vhosts/', '%d', '/', '%n') as home, \
  'maildir:/var/mail/vhosts/%d/%n' as mail, \
  concat('*:bytes=', m."quotaBytes") as quota_rule \
  FROM "Mailbox" m JOIN "Domain" d ON m."domainId" = d."id" \
  WHERE m."address" = '%u' AND m."isActive" = true AND d."status" = 'ACTIVE'

iterate_query = SELECT m."address" as user FROM "Mailbox" m JOIN "Domain" d ON m."domainId" = d."id" WHERE m."isActive" = true AND d."status" = 'ACTIVE'

