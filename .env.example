# ==============================================================================
# Azion Mail - Production Environment Configuration
# Azion Cloud Email Platform
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Primary Domain & Hostname
# ------------------------------------------------------------------------------
MAIL_HOST=mail.azioncloud.com
ACME_EMAIL=admin@azioncloud.com

# Web Reverse Proxy Port Settings (Set to 8088 / 8443 if running alongside Pterodactyl/Paymenter)
CADDY_BIND_IP=0.0.0.0
CADDY_HTTP_PORT=80
CADDY_HTTPS_PORT=443
# CADDY_SITE_ADDR is deprecated — Caddy now uses MAIL_HOST directly for auto-HTTPS

# ------------------------------------------------------------------------------
# 2. Database & Redis Credentials
# ------------------------------------------------------------------------------
POSTGRES_USER=azion
POSTGRES_PASSWORD=replace_with_ultra_secure_password_in_prod
POSTGRES_DB=azionmail
DATABASE_URL=postgresql://azion:replace_with_ultra_secure_password_in_prod@postgres:5432/azionmail?schema=public

REDIS_URL=redis://redis:6379

# ------------------------------------------------------------------------------
# 3. Security & Authentication
# ------------------------------------------------------------------------------
JWT_SECRET=azion_jwt_secret_64_characters_long_random_string_replace_in_prod

# Initial Superadmin Account (Seeded on first deployment)
INITIAL_ADMIN_EMAIL=abhijotdhaliwal80@gmail.com
INITIAL_ADMIN_PASSWORD=AzWbwZfTN9Y%hVErqU@s!9

# ------------------------------------------------------------------------------
# 4. Service Hosts & Ports
# ------------------------------------------------------------------------------
POSTFIX_HOST=postfix
POSTFIX_PORT=25
DOVECOT_HOST=dovecot
DOVECOT_PORT=143
RSPAMD_URL=http://rspamd:11334
WEBMAIL_URL=https://mail.azioncloud.com/webmail

# ------------------------------------------------------------------------------
# 5. Resource Optimization Toggles
# ------------------------------------------------------------------------------
# Set to 'true' only on 4GB+ VPS if you wish to run ClamAV anti-virus engine
ENABLE_CLAMAV=false

# Internal secret shared between Postfix mail archiver and Next.js API (auto-generated on deploy)
INTERNAL_ARCHIVE_SECRET=replace_with_random_internal_secret

# ------------------------------------------------------------------------------
# 6. Cloudflare OAuth Integration
# ------------------------------------------------------------------------------
# Register your app at: https://dash.cloudflare.com/profile/api-tokens
# → Create Token → OAuth App → set redirect URI to https://MAIL_HOST/api/auth/cloudflare/callback
# Scopes needed: account:read  zone:read  dns_records:edit
CLOUDFLARE_CLIENT_ID=your_cloudflare_oauth_client_id
CLOUDFLARE_CLIENT_SECRET=your_cloudflare_oauth_client_secret

# Public URL of this deployment (used for OAuth redirect URI)
NEXT_PUBLIC_APP_URL=https://mail.azioncloud.com
