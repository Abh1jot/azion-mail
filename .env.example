# ==============================================================================
# Azion Mail - Production Environment Configuration
# Azion Cloud Email Platform
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Primary Domain & Hostname
# ------------------------------------------------------------------------------
MAIL_HOST=mail.azioncloud.com
ACME_EMAIL=admin@azioncloud.com

# ------------------------------------------------------------------------------
# 2. Database & Redis Credentials
# ------------------------------------------------------------------------------
POSTGRES_USER=azion
POSTGRES_PASSWORD=replace_with_ultra_secure_password_in_prod
POSTGRES_DB=azionmail
DATABASE_URL=postgresql://azion:replace_with_ultra_secure_password_in_prod@postgres:5432/azionmail?schema=public

REDIS_URL=redis://redis:6379

# ------------------------------------------------------------------------------
# 3. Security & Authentication
# ------------------------------------------------------------------------------
JWT_SECRET=azion_jwt_secret_64_characters_long_random_string_replace_in_prod

# Initial Superadmin Account (Seeded on first deployment)
INITIAL_ADMIN_EMAIL=admin@azioncloud.com
INITIAL_ADMIN_PASSWORD=AzionAdmin2026!

# ------------------------------------------------------------------------------
# 4. Service Hosts & Ports
# ------------------------------------------------------------------------------
POSTFIX_HOST=postfix
POSTFIX_PORT=25
DOVECOT_HOST=dovecot
DOVECOT_PORT=143
RSPAMD_URL=http://rspamd:11334
WEBMAIL_URL=https://mail.azioncloud.com/webmail

# ------------------------------------------------------------------------------
# 5. Resource Optimization Toggles
# ------------------------------------------------------------------------------
# Set to 'true' only on 4GB+ VPS if you wish to run ClamAV anti-virus engine
ENABLE_CLAMAV=false
